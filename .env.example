# Copy to .env and fill in. .env is gitignored.

# JobsPipe API key (dashboard -> Settings -> API Keys). Starts with jp_live_
# Not needed while sources[].mode is "sandbox".
JOBSPIPE_API_KEY=

# Anthropic API key for the AI matching step. Starts with sk-ant-
ANTHROPIC_API_KEY=

# Google Sheet id - the long part of the sheet URL between /d/ and /edit.
# Optional here; can also go in config.yaml under output.google_sheet.spreadsheet_key.
GOOGLE_SHEET_ID=
